rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Visitor Logging Collection Security Rules
    match /portfolio_visits/{visitId} {
      
      // 1. Anyone (anonymous visitors) can create a visit log
      // Validates essential schema to prevent arbitrary garbage payloads
      allow create: if request.resource.data.keys().hasAll(['visitorId', 'timestamp', 'date', 'path'])
                    && request.resource.data.visitorId is string
                    && request.resource.data.timestamp is string;
      
      // 2. Only authenticated administrator (Saurav) can read or delete analytics data
      allow read, delete: if request.auth != null;
      
      // 3. Prohibit any modifications or updates to existing visit history
      allow update: if false;
    }
    
    // Default lock for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
